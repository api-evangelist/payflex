        {
          "id": "e2d3d719-03eb-42ca-8672-593f37dbda19",
          "name": "Create a new BNPL order",
          "request": {
            "name": "Create a new BNPL order",
            "description": {
              "content": "Create a new Payflex installment payment order. Returns a redirectUrl for the consumer to complete the payment flow on the Payflex hosted checkout, as well as an orderId and token for order tracking. Merchants must supply consumer details, billing and shipping addresses, line items, total amount, and redirect URLs for confirmed and cancelled states.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "order",
                "productSelect"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"<string>\",\n  \"consumer\": {\n    \"phoneNumber\": \"<string>\",\n    \"givenNames\": \"<string>\",\n    \"surname\": \"<string>\",\n    \"email\": \"<email>\"\n  },\n  \"merchant\": {\n    \"redirectConfirmUrl\": \"<uri>\",\n    \"redirectCancelUrl\": \"<uri>\"\n  },\n  \"merchantReference\": \"<string>\",\n  \"billing\": {\n    \"addressLine1\": \"<string>\",\n    \"addressLine2\": \"<string>\",\n    \"suburb\": \"<string>\",\n    \"postcode\": \"<string>\"\n  },\n  \"shipping\": {\n    \"addressLine1\": \"<string>\",\n    \"addressLine2\": \"<string>\",\n    \"suburb\": \"<string>\",\n    \"postcode\": \"<string>\"\n  },\n  \"description\": \"<string>\",\n  \"items\": [\n    {\n      \"name\": \"<string>\",\n      \"quantity\": \"<string>\",\n      \"price\": \"<string>\",\n      \"sku\": \"<string>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"quantity\": \"<string>\",\n      \"price\": \"<string>\",\n      \"sku\": \"<string>\"\n    }\n  ],\n  \"taxAmount\": \"<float>\",\n  \"shippingAmount\": \"<float>\",\n  \"merchantSystemInformation\": {\n    \"plugin_version\": \"<string>\",\n    \"php_version\": \"<string>\",\n    \"ecommerce_platform\": \"<string>\",\n    \"total_plugin_modules\": \"<string>\",\n    \"active_plugin_modules\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
