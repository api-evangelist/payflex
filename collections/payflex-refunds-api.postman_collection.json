      "name": "Refunds",
      "description": {
        "content": "Initiate full or partial refunds on completed orders",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b721e3d3-d760-4018-b8e4-eda43d24ceb6",
          "name": "Initiate a refund on an order",
          "request": {
            "name": "Initiate a refund on an order",
            "description": {
              "content": "Submit a full or partial refund request for a completed (Approved) Payflex order. A unique requestId must be provided with each refund request. Partial refunds are supported by specifying an amount less than the original order total.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "order",
                ":orderId",
                "refund"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "orderId",
                  "description": "(Required) The Payflex-issued order identifier to refund"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"<string>\",\n  \"amount\": \"<float>\",\n  \"isPlugin\": \"<boolean>\",\n  \"merchantRefundReference\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
